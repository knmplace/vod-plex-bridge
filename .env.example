# =============================================================================
# VOD Plex Bridge - Environment Configuration
# =============================================================================
# Copy this file to .env next to docker-compose.yml:
#   cp .env.example .env
#
# Only BRIDGE_HOST and SETTINGS_KEY are needed. Dispatcharr, Plex, TMDB and
# streaming mode are entered in the app (Settings tab and Setup tab), where
# secrets are stored encrypted. Everything below the "Optional" line is a
# fallback: a value saved in Settings overrides the one here.
# =============================================================================

# --- Bridge address (REQUIRED) ---
# The LAN IP of THIS machine. Not 0.0.0.0, 127.0.0.1 or localhost.
# Plex/Jellyfin and the Setup commands reach the bridge at BRIDGE_HOST:BRIDGE_PORT.
BRIDGE_HOST=192.168.x.x
BRIDGE_PORT=8585

# --- Settings encryption key (REQUIRED) ---
# Any long random string. Encrypts API keys, tokens and passwords saved in
# Settings. Keep a copy somewhere safe: if it is lost, saved secrets must be
# entered again.
# Make one with:  openssl rand -base64 32
SETTINGS_KEY=

# --- Timezone ---
# Affects log timestamps and the 6:00 AM Daily Run.
TZ=America/New_York

# --- Host folders (used by docker-compose.yml) ---
# DATA_DIR:     database, settings and the Dispatcharr lists.
# PLEX_VOD_DIR: the generated movie and series files. Plex/Jellyfin do NOT read
#               this folder directly; they read the bridge over HTTP through
#               the rclone mount that Setup -> Command B installs.
DATA_DIR=./data
PLEX_VOD_DIR=./plex-vod

# =============================================================================
# Optional - leave these commented out and use the app's Settings tab instead.
# =============================================================================
# DISPATCHARR_URL=http://192.168.x.x:9191
# DISPATCHARR_API_KEY=
# PLEX_URL=http://192.168.x.x:32400
# PLEX_TOKEN=
# PLEX_LIBRARY_ID=
# PLEX_SERIES_LIBRARY_ID=
# TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Streaming mode. false = proxy (default): one shared connection per title,
# start and end of each movie cached at activation.
# true = redirect: Plex/Jellyfin are sent straight to Dispatcharr's proxy, so
# every scan and playback opens its own Dispatcharr connection. Use with
# caution; a VPN on the Plex/Jellyfin machine is recommended. Needs an
# admin-scoped DISPATCHARR_API_KEY. Restart required after changing.
# REDIRECT_MODE=false
# Max connections per title before the oldest are closed (redirect mode only).
# MAX_CONCURRENT_PER_TITLE=2
